# 参考文献异常检测 API 服务环境变量（复制为 .env 或在 systemd 中配置）

# 监听地址与端口（选空闲端口，避免与现有服务冲突）
REFERENCE_API_HOST=0.0.0.0
REFERENCE_API_PORT=18080

# Crossref polite pool 联系邮箱（必填，改为机构邮箱）
CROSSREF_MAILTO=zhangyuyue@bupt.edu.cn

# 撤稿 SQLite 索引路径（先运行 reference-build-retraction-index 生成）
RETRACTION_DB=/data/retraction_watch_index.sqlite

# Crossref 本地缓存（可选，建议挂载持久卷）
# CROSSREF_CACHE=/data/crossref_cache.sqlite
# CROSSREF_CACHE_ENABLED=true

# 上传临时目录
# UPLOAD_TMP_DIR=/tmp/reference-anomaly-api

# 单文件大小上限（字节，默认 50MB）
# MAX_UPLOAD_BYTES=52428800
